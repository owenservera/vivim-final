generator client {
  provider = "prisma-client-js"
  output   = "../../src/generated/system-client"
}

datasource db {
  provider = "sqlite"
  url      = env("SYSTEM_DATABASE_URL")
}

model SchemaMeta {
  key   String
  value String

  @@id([key, value])
}

model ProviderDefinition {
  id               String  @id
  slug             String  @unique
  displayName      String  @map("display_name")
  description      String?
  category         String  @default("ai")
  providerType     String  @default("llm") @map("provider_type")
  isActive         Int     @default(1) @map("is_active")
  protocolStatus   String  @default("Active") @map("protocol_status")
  websiteUrl       String? @map("website_url")
  documentationUrl String? @map("documentation_url")
  authType         String  @default("browser") @map("auth_type")
  hasMultiAccount  Int     @default(0) @map("has_multi_account")
  profileStrategy  String  @default("per_account") @map("profile_strategy")
  fleetConfigJson  String  @default("{}") @map("fleet_config_json")
  capabilitiesJson String  @default("{}") @map("capabilities_json")
  modelsJson       String  @default("[]") @map("models_json")
  pluginId         String? @map("plugin_id")
  createdAt        BigInt  @map("created_at")
  updatedAt        BigInt  @map("updated_at")

  endpoints             ProviderEndpoint[]
  parsers               ProviderParser[]
  capabilities          ProviderCapability[]
  configs               ProviderConfig[]
  models                ProviderModel[]
  accounts              ProviderAccount[]
  overrides             ProviderOverride[]
  // L5
  manifestVersions      ProviderManifestVersion[]
  registrationEvents    RegistrationEvent[]
  manifestDrifts        ManifestDrift[]
  // L7
  healthHistories       ProviderHealthHistory[]
  capabilityTelemetry   CapabilityTelemetry[]
  telemetrySummaries    TelemetrySummaryDaily[]
  manifestChangeLogs    ManifestChangeLog[]
  // L11
  healthTicks           HealthTick[]
  driftEvents           DriftEvent[]
  fleetEvents           FleetEvent[]
  providerHealth        ProviderHealth?
  alertConditions       AlertCondition[]
  // L4
  // L6
  bindings              CapabilityBinding[]
  selectorStrategies    SelectorStrategy[]
  // L7
  // L9
  macros                CapabilityMacro[]
  // L12
  routeSpecs            RouteSpec[]
  transferPatternsFrom  TransferPattern[]         @relation("FromProvider")
  transferPatternsTo    TransferPattern[]         @relation("ToProvider")
  learningEvents        LearningEvent[]
  providerStreamConfigs ProviderStreamConfig[]

  @@map("provider_definition")
}

model ProviderEndpoint {
  id            String @id
  providerId    String @map("provider_id")
  url           String
  label         String
  endpointType  String @default("landing") @map("endpoint_type")
  isDefault     Int    @default(0) @map("is_default")
  selectorsJson String @default("{}") @map("selectors_json")

  // DOM Interaction Config
  composerType    String @default("textarea") @map("composer_type")
  // 'textarea' | 'contenteditable' | 'prosemirror' | 'quill'
  sendMethod      String @default("both") @map("send_method")
  // 'enter_key' | 'button_click' | 'both'
  contentEditable Int    @default(0) @map("content_editable")
  // 1 = requires Input.insertText, 0 = standard textarea

  createdAt BigInt @map("created_at")
  updatedAt BigInt @map("updated_at")

  provider ProviderDefinition @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId], map: "idx_pe_provider")
  @@map("provider_endpoint")
}

model ProviderParser {
  id               String  @id
  providerId       String  @map("provider_id")
  parserName       String  @map("parser_name")
  parserVersion    Int     @default(1) @map("parser_version")
  parserLogicType  String  @default("file") @map("parser_logic_type")
  parserFilePath   String? @map("parser_file_path")
  parserLogicCode  String? @map("parser_logic_code") // Inline TypeScript/JavaScript for DB-driven loading
  parserHash       String? @map("parser_hash")
  sampleBody       String? @map("sample_body") // Representative wire-format sample for testing
  isActive         Int     @default(1) @map("is_active")
  fallbackParserId String? @map("fallback_parser_id")
  createdAt        BigInt  @map("created_at")
  updatedAt        BigInt  @map("updated_at")

  provider       ProviderDefinition @relation(fields: [providerId], references: [id], onDelete: Cascade)
  fallbackParser ProviderParser?    @relation("FallbackParser", fields: [fallbackParserId], references: [id], onDelete: SetNull)
  fallbackFor    ProviderParser[]   @relation("FallbackParser")

  @@index([providerId], map: "idx_pp_provider")
  @@map("provider_parser")
}

model ProviderCapability {
  id                          String  @id
  providerId                  String  @map("provider_id")
  globalCapabilityId          String  @map("global_capability_id")
  recoveryStrategiesJson      String  @default("[]") @map("recovery_strategies_json")
  uiComponentOverride         String? @map("ui_component_override")
  uiLabelOverride             String? @map("ui_label_override")
  uiIconOverride              String? @map("ui_icon_override")
  uiPositionOverride          String? @map("ui_position_override")
  uiOrderOverride             Int?    @map("ui_order_override")
  uiGroupOverride             String? @map("ui_group_override")
  uiPriorityOverride          String? @map("ui_priority_override")
  interactionModeOverride     String? @map("interaction_mode_override")
  uiStatesOverrideJson        String? @map("ui_states_override_json")
  uiVisibilityRuleOverride    String? @map("ui_visibility_rule_override")
  existentialRuleOverride     String? @map("existential_rule_override")
  uiInputSchemaOverride       String? @map("ui_input_schema_override")
  mutationEffectsOverrideJson String? @map("mutation_effects_override_json")
  recoveryBehaviorOverride    String? @map("recovery_behavior_override")
  statePersistenceOverride    String? @map("state_persistence_override")
  dataFlowOverride            String? @map("data_flow_override")
  minPlanTierOverride         String? @map("min_plan_tier_override")
  dependsOnOverrideJson       String? @map("depends_on_override_json")
  confidence                  Float   @default(1.0)
  successCount                Int     @default(0) @map("success_count")
  failCount                   Int     @default(0) @map("fail_count")
  consecutiveFailures         Int     @default(0) @map("consecutive_failures")
  avgLatencyMs                Float   @default(0) @map("avg_latency_ms")
  p95LatencyMs                Float   @default(0) @map("p95_latency_ms")
  lastUsedAt                  BigInt? @map("last_used_at")
  selectorHitCount            Int     @default(0) @map("selector_hit_count")
  selectorMissCount           Int     @default(0) @map("selector_miss_count")
  selectorLastMissAt          BigInt? @map("selector_last_miss_at")
  selectorLastError           String? @map("selector_last_error")
  createdAt                   BigInt  @map("created_at")
  updatedAt                   BigInt  @map("updated_at")

  provider ProviderDefinition @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, globalCapabilityId])
  @@index([providerId], map: "idx_pc_provider")
  @@index([globalCapabilityId], map: "idx_pc_cap")
  @@index([providerId, confidence], map: "idx_pc_confidence")
  @@index([providerId, selectorHitCount], map: "idx_pc_selector")
  @@map("provider_capability")
}

model ProviderConfig {
  id          String @id
  providerId  String @map("provider_id")
  configKey   String @map("config_key")
  configValue String @map("config_value")
  configType  String @default("string") @map("config_type")
  isSecret    Int    @default(0) @map("is_secret")
  createdAt   BigInt @map("created_at")
  updatedAt   BigInt @map("updated_at")

  provider ProviderDefinition @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, configKey])
  @@map("provider_config")
}

model ProviderModel {
  id                 String @id
  providerId         String @map("provider_id")
  modelSlug          String @map("model_slug")
  displayName        String @map("display_name")
  isActive           Int    @default(1) @map("is_active")
  isDefault          Int    @default(0) @map("is_default")
  capabilitiesJson   String @default("[]") @map("capabilities_json")
  contextWindow      Int?   @map("context_window")
  maxOutputTokens    Int?   @map("max_output_tokens")
  supportsStreaming  Int    @default(0) @map("supports_streaming")
  supportsVision     Int    @default(0) @map("supports_vision")
  supportsThinking   Int    @default(0) @map("supports_thinking")
  supportsTools      Int    @default(0) @map("supports_tools")
  pricingInputPer1m  Float? @map("pricing_input_per_1m")
  pricingOutputPer1m Float? @map("pricing_output_per_1m")
  createdAt          BigInt @map("created_at")
  updatedAt          BigInt @map("updated_at")

  provider ProviderDefinition @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, modelSlug])
  @@map("provider_model")
}

model ProviderAccount {
  id                String  @id
  providerId        String  @map("provider_id")
  email             String
  planTier          String  @default("free") @map("plan_tier")
  isDefault         Int     @default(0) @map("is_default")
  isKind            Int     @default(0) @map("is_kind")
  loginState        String  @default("unknown") @map("login_state")
  loginAttempts     Int     @default(0) @map("login_attempts")
  lastLoginAt       BigInt? @map("last_login_at")
  providerStateJson String  @default("{}") @map("provider_state_json")
  debugPort         Int?    @map("debug_port")
  profileDir        String? @map("profile_dir")
  chromeSlaveId     String? @map("chrome_slave_id")
  userId            String  @default("default") @map("user_id")
  createdAt         BigInt  @map("created_at")
  updatedAt         BigInt  @map("updated_at")

  provider ProviderDefinition @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, email])
  @@index([providerId], map: "idx_pa_provider")
  @@index([email], map: "idx_pa_email")
  @@index([loginState], map: "idx_pa_login")
  @@map("provider_account")
}

model ProviderStreamConfig {
  id                      String  @id
  providerId              String  @map("provider_id")
  streamTransport         String  @map("stream_transport") // 'sse' | 'batchexecute' | 'websocket' | 'sse-patch'
  streamTerminalJson      String  @default("[]") @map("stream_terminal_json")
  sseFormat               String? @map("sse_format") // 'openai' | 'anthropic' | 'gemini' | 'generic'
  deltaPathJson           String? @map("delta_path_json")
  contentType             String? @map("content_type")
  completionDetectorsJson String  @default("[]") @map("completion_detectors_json")
  harnessJs               String? @map("harness_js")
  isActive                Int     @default(1) @map("is_active")
  version                 Int     @default(1)
  supersededById          String? @map("superseded_by")
  createdAt               BigInt  @map("created_at")
  updatedAt               BigInt  @map("updated_at")

  provider      ProviderDefinition     @relation(fields: [providerId], references: [id], onDelete: Cascade)
  supersededBy  ProviderStreamConfig?  @relation("SuperStreamConfig", fields: [supersededById], references: [id])
  supersersedes ProviderStreamConfig[] @relation("SuperStreamConfig")

  @@unique([providerId, streamTransport, version])
  @@index([providerId], map: "idx_psc_provider")
  @@index([streamTransport], map: "idx_psc_transport")
  @@map("provider_stream_config")
}

model TraceEntry {
  id             String  @id
  engine         String
  method         String
  requestId      String? @map("request_id")
  conversationId String? @map("conversation_id")
  providerId     String? @map("provider_id")
  accountId      String? @map("account_id")
  slaveId        String? @map("slave_id")
  cdpMethod      String? @map("cdp_method")
  cdpParamsJson  String? @map("cdp_params_json")
  cdpResultJson  String? @map("cdp_result_json")
  durationMs     Int     @default(0) @map("duration_ms")
  ok             Int     @default(1)
  error          String?
  ts             BigInt

  @@index([engine, ts], map: "idx_te_engine")
  @@index([conversationId, ts], map: "idx_te_conv")
  @@index([providerId, ts], map: "idx_te_provider")
  @@index([slaveId, ts], map: "idx_te_slave")
  @@map("trace_entry")
}

model CapabilityTaxonomy {
  id                       String  @id
  name                     String
  slug                     String  @unique
  category                 String
  description              String?
  inputType                String  @default("void") @map("input_type")
  uiComponent              String  @default("action_button") @map("ui_component")
  uiLabel                  String? @map("ui_label")
  uiIcon                   String? @map("ui_icon")
  uiPosition               String  @default("composer") @map("ui_position")
  uiOrder                  Int     @default(0) @map("ui_order")
  uiLayerDepth             Int     @default(0) @map("ui_layer_depth")
  parentCapabilityId       String? @map("parent_capability_id")
  uiGroup                  String  @default("default") @map("ui_group")
  uiPriority               String  @default("secondary") @map("ui_priority")
  interactionMode          String  @default("single_click") @map("interaction_mode")
  uiStatesJson             String  @default("[]") @map("ui_states_json")
  uiVisibilityRule         String? @map("ui_visibility_rule")
  existentialRule          String? @map("existential_rule")
  uiInputSchema            String  @default("{}") @map("ui_input_schema")
  mutationEffectsJson      String  @default("{}") @map("mutation_effects_json")
  recoveryBehavior         String  @default("retry_manual") @map("recovery_behavior")
  statePersistence         String  @default("none") @map("state_persistence")
  dataFlow                 String  @default("user_to_provider") @map("data_flow")
  minPlanTier              String  @default("free") @map("min_plan_tier")
  dependsOnJson            String  @default("[]") @map("depends_on_json")
  concurrencySafe          Int     @default(0) @map("concurrency_safe")
  opClassification         String? @map("op_classification")
  requiresUserConfirmation Int     @default(0) @map("requires_user_confirmation")
  maxResultSize            Int     @default(100000) @map("max_result_size")
  resultComponent          String  @default("text_block") @map("result_component")
  resultLayout             String  @default("inline") @map("result_layout")
  searchHintsJson          String  @default("[]") @map("search_hints_json")
  aliasesJson              String  @default("[]") @map("aliases_json")
  availabilityJson         String  @default("{}") @map("availability_json")
  prefetch                 Int     @default(0)
  createdAt                BigInt  @map("created_at")
  updatedAt                BigInt  @map("updated_at")

  parent     CapabilityTaxonomy?         @relation("ParentCapability", fields: [parentCapabilityId], references: [id], onDelete: SetNull)
  children   CapabilityTaxonomy[]        @relation("ParentCapability")
  tiers      CapabilityTier[]
  bindings   CapabilityBinding[]
  selectors  SelectorStrategy[]
  outcomes   Outcome[]
  // L6
  versions   CapabilityTaxonomyVersion[]
  // L7
  telemetry  CapabilityTelemetry[]
  // L12
  routeSpecs RouteSpec[]
  transfers  TransferPattern[]
  learning   LearningEvent[]
  // 1.3 — Override and Intent relations
  overrides  ProviderOverride[]
  intents    CapabilityIntent[]

  @@index([category], map: "idx_ct_category")
  @@index([uiPosition, uiGroup, uiOrder], map: "idx_ct_position")
  @@index([slug], map: "idx_ct_slug")
  @@index([parentCapabilityId], map: "idx_ct_parent")
  @@index([opClassification], map: "idx_ct_classification")
  @@map("capability_taxonomy")
}

model CapabilityTier {
  id                    String  @id
  capabilityId          String  @map("capability_id")
  planTier              String  @map("plan_tier")
  maxModels             Int?    @map("max_models")
  maxFileSize           Int?    @map("max_file_size")
  maxOptions            Int?    @map("max_options")
  customConfigJson      String  @default("{}") @map("custom_config_json")
  uiStatesOverrideJson  String? @map("ui_states_override_json")
  uiComponentOverride   String? @map("ui_component_override")
  uiLabelOverride       String? @map("ui_label_override")
  uiIconOverride        String? @map("ui_icon_override")
  uiInputSchemaOverride String? @map("ui_input_schema_override")
  createdAt             BigInt  @map("created_at")
  updatedAt             BigInt  @map("updated_at")

  capability CapabilityTaxonomy @relation(fields: [capabilityId], references: [id], onDelete: Cascade)

  @@unique([capabilityId, planTier])
  @@map("capability_tier")
}

model CapabilityBinding {
  id                   String  @id
  globalId             String  @map("global_id")
  providerId           String  @map("provider_id")
  status               String  @default("prospect")
  bestProgramId        String? @map("best_program_id")
  currentProgramId     String? @map("current_program_id")
  promotionHistoryJson String  @default("[]") @map("promotion_history_json")
  confidence           Float   @default(0.0)
  createdAt            BigInt  @map("created_at")
  updatedAt            BigInt  @map("updated_at")

  capability              CapabilityTaxonomy      @relation(fields: [globalId], references: [id], onDelete: Cascade)
  provider                ProviderDefinition      @relation(fields: [providerId], references: [id], onDelete: Cascade)
  programs                CapabilityProgram[]
  // L6
  statusLogs              BindingStatusLog[]
  versionMetrics          ProgramVersionMetric[]
  // L7
  selectorHealthHistories SelectorHealthHistory[]
  // L12
  bindingEvents           BindingEvent[]

  @@unique([globalId, providerId])
  @@index([providerId], map: "idx_cb_provider")
  @@index([status], map: "idx_cb_status")
  @@index([globalId], map: "idx_cb_global")
  @@map("capability_binding")
}

model ProviderOverride {
  id           String @id
  providerId   String @map("provider_id")
  capabilityId String @map("capability_id")
  overrideType String @map("override_type")
  overrideJson String @map("override_json")
  createdAt    BigInt @map("created_at")

  provider   ProviderDefinition @relation(fields: [providerId], references: [id], onDelete: Cascade)
  capability CapabilityTaxonomy @relation(fields: [capabilityId], references: [id], onDelete: Cascade)

  @@unique([providerId, capabilityId, overrideType])
  @@map("capability_override")
}

model CapabilityIntent {
  id           String @id
  capabilityId String @map("capability_id")
  intentText   String @map("intent_text")
  patternsJson String @map("patterns_json")
  confidence   Float  @default(1.0)
  isPrimary    Int    @default(0) @map("is_primary")
  createdAt    BigInt @map("created_at")

  capability CapabilityTaxonomy @relation(fields: [capabilityId], references: [id], onDelete: Cascade)

  @@index([intentText], map: "idx_ci_intent")
  @@index([isPrimary], map: "idx_ci_primary")
  @@map("capability_intent")
}

model CapabilityProgram {
  id             String  @id
  bindingId      String  @map("binding_id")
  version        Int     @default(1)
  name           String?
  supersededById String? @map("superseded_by")
  isActive       Int     @default(1) @map("is_active")
  configJson     String  @default("{}") @map("config_json")
  createdAt      BigInt  @map("created_at")
  updatedAt      BigInt  @map("updated_at")

  binding        CapabilityBinding      @relation(fields: [bindingId], references: [id], onDelete: Cascade)
  supersededBy   CapabilityProgram?     @relation("SupersededProgram", fields: [supersededById], references: [id], onDelete: SetNull)
  supersededFrom CapabilityProgram[]    @relation("SupersededProgram")
  metrics        ProgramVersionMetric[]

  @@index([bindingId], map: "idx_cp_binding")
  @@map("capability_program")
}

model SelectorStrategy {
  id            String  @id
  name          String
  capabilityId  String  @map("capability_id")
  providerId    String  @map("provider_id")
  strategyType  String  @map("strategy_type")
  selectorValue String  @map("selector_value")
  priority      Int     @default(1)
  isActive      Int     @default(1) @map("is_active")
  hitCount      Int     @default(0) @map("hit_count")
  missCount     Int     @default(0) @map("miss_count")
  lastUsedAt    BigInt? @map("last_used_at")
  createdAt     BigInt  @map("created_at")
  updatedAt     BigInt  @map("updated_at")

  capability      CapabilityTaxonomy      @relation(fields: [capabilityId], references: [id], onDelete: Cascade)
  provider        ProviderDefinition      @relation(fields: [providerId], references: [id], onDelete: Cascade)
  healthHistories SelectorHealthHistory[]

  @@index([capabilityId, providerId], map: "idx_ss_cap")
  @@index([providerId], map: "idx_selstrat_provider")
  @@map("selector_strategy")
}

model Outcome {
  id                 String  @id
  capabilityId       String  @map("capability_id")
  bindingId          String? @map("binding_id")
  providerId         String  @map("provider_id")
  programId          String? @map("program_id")
  selectorStrategyId String? @map("selector_strategy_id")
  ok                 Int     @default(0)
  error              String?
  durationMs         Int?    @map("duration_ms")
  confidence         Float?
  selectorUsed       String? @map("selector_used")
  selectorHit        Int?    @map("selector_hit")
  ts                 BigInt

  capability             CapabilityTaxonomy      @relation(fields: [capabilityId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  // L12
  failureClassifications FailureClassification[]

  @@index([providerId, ts], map: "idx_o_provider")
  @@index([capabilityId, ts], map: "idx_o_cap")
  @@index([ok, ts], map: "idx_o_ok")
  @@index([ts], map: "idx_o_ts")
  @@map("outcome")
}

model ParserExecutionLog {
  id             String  @id
  providerId     String  @map("provider_id")
  parserName     String  @map("parser_name")
  parserVersion  Int     @map("parser_version")
  conversationId String? @map("conversation_id")
  messageId      String? @map("message_id")
  confidence     Float
  blockCount     Int     @map("block_count")
  textBlocks     Int     @default(0) @map("text_blocks")
  toolCallBlocks Int     @default(0) @map("tool_call_blocks")
  fileBlocks     Int     @default(0) @map("file_blocks")
  errorBlocks    Int     @default(0) @map("error_blocks")
  durationMs     Int     @map("duration_ms")
  rawSizeBytes   Int     @default(0) @map("raw_size_bytes")
  wireFormat     String? @map("wire_format")
  fallbackUsed   Int     @default(0) @map("fallback_used")
  metadataJson   String  @default("{}") @map("metadata_json")
  createdAt      BigInt  @map("created_at")

  @@index([providerId, createdAt], map: "idx_pel_provider")
  @@index([conversationId], map: "idx_pel_conversation")
  @@index([confidence], map: "idx_pel_confidence")
  @@map("parser_execution_log")
}

model ProviderManifestVersion {
  id            String  @id
  providerId    String  @map("provider_id")
  manifestFile  String  @map("manifest_file")
  version       Int     @default(1)
  hash          String
  contentJson   String  @map("content_json")
  changeSummary String? @map("change_summary")
  actor         String  @default("system")
  createdAt     BigInt  @map("created_at")

  provider ProviderDefinition @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, manifestFile, version])
  @@index([providerId, version], map: "idx_pmv_provider")
  @@map("provider_manifest_version")
}

model RegistrationEvent {
  id                String  @id
  providerId        String  @map("provider_id")
  manifestVersionId String? @map("manifest_version_id")
  eventType         String  @map("event_type")
  tableName         String  @map("table_name")
  recordId          String? @map("record_id")
  fieldName         String? @map("field_name")
  fromValue         String? @map("from_value")
  toValue           String? @map("to_value")
  changeSummary     String? @map("change_summary")
  actor             String  @default("system")
  ts                BigInt

  provider ProviderDefinition @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId, ts], map: "idx_re_provider")
  @@index([eventType], map: "idx_re_type")
  @@index([tableName], map: "idx_re_table")
  @@map("registration_event")
}

model ManifestDrift {
  id              String  @id
  providerId      String  @map("provider_id")
  driftType       String  @map("drift_type")
  tableName       String? @map("table_name")
  recordId        String? @map("record_id")
  seedValue       String? @map("seed_value")
  dbValue         String? @map("db_value")
  resolved        Int     @default(0)
  resolvedByActor String? @map("resolved_by_actor")
  resolvedAt      BigInt? @map("resolved_at")
  detectedAt      BigInt  @map("detected_at")

  provider ProviderDefinition @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId, resolved, detectedAt], map: "idx_md_provider")
  @@map("manifest_drift")
}

model CapabilityTaxonomyVersion {
  id                String  @id
  capabilityId      String  @map("capability_id")
  version           Int
  snapshotJson      String  @map("snapshot_json")
  changeSummary     String? @map("change_summary")
  changedFieldsJson String  @default("[]") @map("changed_fields_json")
  actor             String  @default("system")
  createdAt         BigInt  @map("created_at")

