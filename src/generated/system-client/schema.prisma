  errorMessage   String?  @map("error_message")
  errorRetryable Boolean? @map("error_retryable")

  inputTokens  Int? @map("input_tokens")
  outputTokens Int? @map("output_tokens")
  totalTokens  Int? @map("total_tokens")

  events AIExecutionEvent[]

  @@index([requestId], map: "idx_aiexec_request")
  @@index([state], map: "idx_aiexec_state")
  @@index([providerId], map: "idx_aiexec_provider")
  @@index([createdAt], map: "idx_aiexec_created")
  @@map("ai_execution")
}

model AIExecutionEvent {
  // ctx: ai-gateway
  id          String @id // EventId (ULID)
  executionId String @map("execution_id")
  sequence    Int
  timestamp   String
  type        String // execution.created|state-changed|provider-selected|ai-event|completed|failed|cancelled
  payloadJson String @map("payload_json") // full event payload as JSON

  execution AIExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId], map: "idx_aievent_exec")
  @@index([sequence], map: "idx_aievent_seq")
  @@map("ai_execution_event")
}

model AIProviderInstance {
  // ctx: ai-gateway — gateway-local provider registry (separate identity namespace
  // from ProviderDefinition which holds CDP providers). No cross-write [AUDIT R-10].
  id               String  @id // ProviderId
  pluginId         String  @map("plugin_id")
  name             String
  version          String
  protocolVersion  String  @map("protocol_version")
  kind             String // local|remote|hybrid|embedded
  trust            String // official|verified|community|unverified|blocked
  state            String // discovered|installed|validating|enabled|starting|ready|active|degraded|unhealthy|draining|disabled|stopped|failed
  capabilitiesJson String  @default("{}") @map("capabilities_json")
  extensionsJson   String? @map("extensions_json")
  integrityHash    String? @map("integrity_hash")
  signature        String?
  certifiedAt      String? @map("certified_at")
  installedAt      String  @map("installed_at")
  updatedAt        String  @map("updated_at")

  @@index([state], map: "idx_aiprovider_state")
  @@index([kind], map: "idx_aiprovider_kind")
  @@map("ai_provider_instance")
}
