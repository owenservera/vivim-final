{
  "provider": {
    "slug": "discord",
    "display_name": "Discord",
    "description": "Discord chat platform integration",
    "category": "chat",
    "provider_type": "webapp",
    "website_url": "https://discord.com",
    "documentation_url": "https://discord.com/developers/docs",
    "auth_type": "oauth2",
    "has_multi_account": true,
    "profile_strategy": "browser",
    "capabilities": [
      "send_message",
      "send_reply",
      "create_thread",
      "join_voice_channel",
      "manage_roles",
      "react_to_message",
      "pin_message"
    ]
  },
  "endpoints": [
    {
      "label": "api",
      "url": "https://discord.com/api/v10",
      "endpoint_type": "api",
      "is_default": true
    },
    {
      "label": "gateway",
      "url": "wss://gateway.discord.gg/?v=10&encoding=json",
      "endpoint_type": "auth",
      "is_default": false
    }
  ],
  "parsers": [
    { "name": "discord-gateway", "version": 1, "is_active": true, "fallback": "generic-format-agnostic" }
  ],
  "models": [],
  "capabilities_config": [],
  "config": [
    { "key": "bot_token", "value": "DISCORD_BOT_TOKEN", "is_secret": true },
    { "key": "client_id", "value": "DISCORD_CLIENT_ID", "is_secret": false },
    { "key": "client_secret", "value": "DISCORD_CLIENT_SECRET", "is_secret": true }
  ]
}
