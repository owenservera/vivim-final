{
  "provider": {
    "slug": "openai_api",
    "display_name": "OpenAI (API)",
    "description": "Direct OpenAI API access",
    "category": "ai",
    "provider_type": "llm",
    "website_url": "https://openai.com",
    "documentation_url": "https://platform.openai.com/docs",
    "auth_type": "api_key",
    "has_multi_account": true,
    "profile_strategy": "none",
    "capabilities": ["send_message", "select_model", "toggle_web_search"]
  },
  "endpoints": [
    {
      "label": "api",
      "url": "https://api.openai.com/v1/chat/completions",
      "endpoint_type": "api",
      "is_default": true
    }
  ],
  "parsers": [
    { "name": "openai-sse", "version": 1, "is_active": true, "fallback": "generic-format-agnostic" }
  ],
  "models": [
    { "slug": "gpt-4o", "display_name": "GPT-4o", "is_default": true, "supports_streaming": true },
    { "slug": "gpt-4-turbo", "display_name": "GPT-4 Turbo", "supports_streaming": true },
    { "slug": "gpt-3.5-turbo", "display_name": "GPT-3.5 Turbo", "supports_streaming": true }
  ],
  "capabilities_config": [],
  "config": [{ "key": "api_key", "value": "OPENAI_API_KEY", "is_secret": true }]
}
