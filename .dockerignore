# .dockerignore — exclude from Docker build context
# Session 2 (2026-08-07): created alongside the Dockerfile.
# Keeping the build context small = faster builds + smaller image layers.

# VCS
.git
.gitignore
.gitattributes

# Node / Bun
node_modules
**/node_modules
bun.lock
**/bun.lock

# Build outputs (regenerated inside the container)
dist
.next
frontend/.next
*.tsbuildinfo

# Database files (do not bake into the image)
prisma/dev.db
prisma/*.db-journal
prisma/tests/fixtures/*.db
data/
*.sqlite
*.sqlite3

# Runtime artifacts
.runtime/
tool-results/
bench/results/
coverage/
*.log

# IDE / OS
.vscode
.idea
.DS_Store
Thumbs.db

# Docs that don't belong in the runtime image
docs/review-system/runs/
docs/atomic-v*/
docs/decisions/ADR-*.md.bak

# Frontend test artifacts
frontend/test-results/
frontend/playwright-report/
frontend/coverage/

# Skills / devops cache (regenerated)
.skills/
.opencode/

# This Dockerfile + compose (don't ship the build manifests)
Dockerfile
docker-compose.yml
.dockerignore

# CI
.github
