{
  "$schema": "https://biomejs.dev/schemas/2.5.8/schema.json",
  "files": {
    "includes": [
      "**/src/**",
      "**/tests/**",
      "**/seeds/**",
      "**/frontend/src/**",
      "!**/seeds/taxonomy/openclaw-harvest.json",
      "!**/seeds/taxonomy/pool.taxonomy.json",
      "!**/seeds/taxonomy/surface-projections.json",
      "!**/src/__generated__/**",
      "!**/src/generated/**"
    ],
    "maxSize": 5242880
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedImports": "warn",
        "noUnusedVariables": "warn"
      },
      "suspicious": {
        "noExplicitAny": "off"
      },
      "style": {
        "noNonNullAssertion": "warn",
        "useConst": "warn"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded"
    }
  },
  "json": {
    "formatter": {
      "enabled": true,
      "indentWidth": 2,
      "lineWidth": 100
    }
  },
  "overrides": [
    {
      "includes": ["**/tests/**/*.ts", "**/tests/**/*.tsx"],
      "linter": {
        "rules": {
          "suspicious": {
            "noAssignInExpressions": "warn"
          }
        }
      }
    },
    {
      "includes": ["**/src/**/*.ts"],
      "linter": {
        "rules": {
          "style": {},
          "suspicious": {
            "noConsole": "error"
          }
        }
      }
    },
    {
      "includes": ["**/src/cli/**/*.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": ["**/logger.ts", "**/*.test.ts", "**/__tests__/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    }
  ]
}
