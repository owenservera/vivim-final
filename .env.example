# ── Server ────────────────────────────────────────────────────────────────────
CAP_STORE_HOST=127.0.0.1
CAP_STORE_PORT=9420
CAP_STORE_AUTH_TOKEN=
CAP_STORE_CORS_ORIGIN=http://localhost:3000,http://localhost:5175

# ── Storage ───────────────────────────────────────────────────────────────────
VIVIM_STORAGE_PROVIDER=memory            # 'memory' (default), 'prisma', or 'test' (reserved)
CAP_STORE_DATA_DIR=
CAP_STORE_DB_PATH=
DATABASE_URL=                          # If set, overrides CAP_STORE_DB_PATH for Prisma
CAP_STORE_ENCRYPT_DB=false

# ── Chrome / Fleet ────────────────────────────────────────────────────────────
CAP_STORE_CHROME_PATH=
CAP_STORE_PROFILE_DIR=
CAP_STORE_AUTO_START_FLEET=false
CAP_STORE_FLEET_PORT_START=9222
CAP_STORE_FLEET_PORT_END=9250
CAP_STORE_HEALTH_PROBE_MS=30000

# ── Circuit Breaker ───────────────────────────────────────────────────────────
CAP_STORE_CIRCUIT_THRESHOLD=5
CAP_STORE_CIRCUIT_RESET_MS=30000
CAP_STORE_HPE_RETENTION_DAYS=30

# ── Frontend ──────────────────────────────────────────────────────────────────
FRONTEND_DIR=                          # If set, backend serves static files from this dir (production)
NEXT_PUBLIC_API_URL=http://localhost:9420

# ── Logging ───────────────────────────────────────────────────────────────────
CAP_STORE_LOG_LEVEL=info

# ── Provider API Keys (optional — only needed for API providers, not Chrome-login providers) ──
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
GOOGLE_API_KEY=

# ── OpenTelemetry (optional) ──────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=vivim-final

# ── OpenCode local agent ──────────────────────────────────────────────────────
OPENCODE_MODEL_SYNC_ENABLED=1           # Daily background refresh of the free-model allow-list ('0' disables)
OPENCODE_MODEL_SYNC_INTERVAL_HOURS=24   # How often to re-pull from the opencode CLI
OPENCODE_MODEL_SYNC_REFRESH=0           # Force `opencode models --refresh` (re-pull from models.dev) on each sync
OPENCODE_SERVE_ENABLED=0                # Enable the `opencode serve` session layer (feature 029)
OPENCODE_SERVE_PORT=                    # Port for opencode serve (default: auto)
OPENCODE_SERVER_PASSWORD=               # Password for the opencode serve HTTP API
OPENCODE_SERVER_USERNAME=opencode

# ── AI Gateway (src/ai/) ───────────────────────────────────────────────────────
# Canonical AI execution layer. When disabled, cap:ai:execute returns an error.
# When enabled, the gateway boots with in-memory stores + simulator adapter.
# If OPENCODE_SERVE_ENABLED=1, the OpenCode adapter is also registered.
AI_GATEWAY_ENABLED=0                      # Master switch for the AI Gateway (default: off)

# ── Dev-only ──────────────────────────────────────────────────────────────────
FORCE_SEED=                            # When set, forces re-seed even if DB has providers
DEBUG=false
