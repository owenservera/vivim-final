# Prisma SQLite database URL (legacy — kept for backward compat during transition)
DATABASE_URL="file:./dev.db"

# Dual-DB URLs (Step 2) — paths relative to prisma/system/ and prisma/user/
SYSTEM_DATABASE_URL="file:../data/system.db"
USER_DATABASE_URL="file:../data/user.db"

# OpenCode serve (local provider) — local AI backbone for AI calls
OPENCODE_SERVE_ENABLED=1
OPENCODE_SERVER_PASSWORD=opencode-test-pw
