{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vivim.app/schemas/lifecycle.schema.json",
  "title": "LifecycleConfig",
  "type": "object",
  "properties": {
    "traces_ttl_hours": {
      "type": "integer",
      "default": 48,
      "minimum": 1,
      "maximum": 720,
      "description": "Trace retention time in hours",
      "x-visibility": "basic"
    },
    "sessions_ttl_hours": {
      "type": "integer",
      "default": 6,
      "minimum": 1,
      "maximum": 168,
      "description": "Session retention time in hours",
      "x-visibility": "basic"
    },
    "sync_history_ttl_days": {
      "type": "integer",
      "default": 30,
      "minimum": 1,
      "maximum": 365,
      "description": "Sync history retention in days",
      "x-visibility": "basic"
    },
    "ttl_sweep_interval_secs": {
      "type": "integer",
      "default": 3600,
      "minimum": 60,
      "maximum": 86400,
      "description": "Interval between TTL sweep runs",
      "x-visibility": "expert"
    },
    "telemetry_max_client": {
      "type": "integer",
      "default": 1000,
      "minimum": 100,
      "maximum": 10000,
      "description": "Maximum client metrics before pruning",
      "x-visibility": "expert"
    },
    "alert_max_per_provider": {
      "type": "integer",
      "default": 5,
      "minimum": 1,
      "maximum": 50,
      "description": "Maximum auth alerts per provider",
      "x-visibility": "advanced"
    },
    "alert_prune_after_ms": {
      "type": "integer",
      "default": 86400000,
      "description": "Alert pruning age in milliseconds (default 24h)",
      "x-visibility": "advanced"
    },
    "audit_max_entries": {
      "type": "integer",
      "default": 1000,
      "minimum": 100,
      "maximum": 100000,
      "description": "Maximum permission audit log entries",
      "x-visibility": "advanced"
    }
  },
  "additionalProperties": false
}
