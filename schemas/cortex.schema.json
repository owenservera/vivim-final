{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vivim.app/schemas/cortex.schema.json",
  "title": "CortexConfig",
  "type": "object",
  "properties": {
    "embed_dim": {
      "type": "integer",
      "default": 1536,
      "description": "Embedding vector dimension",
      "x-visibility": "expert"
    },
    "hnsw_m": {
      "type": "integer",
      "default": 16,
      "minimum": 4,
      "maximum": 64,
      "description": "HNSW graph parameter M (connections per node)",
      "x-visibility": "expert"
    },
    "hnsw_ef_construction": {
      "type": "integer",
      "default": 200,
      "minimum": 50,
      "maximum": 1000,
      "description": "HNSW ef_construction parameter",
      "x-visibility": "expert"
    },
    "maintenance_debounce_secs": {
      "type": "integer",
      "default": 30,
      "minimum": 5,
      "maximum": 300,
      "description": "Debounce interval for LCG maintenance",
      "x-visibility": "advanced"
    },
    "hot_recency_secs": {
      "type": "integer",
      "default": 86400,
      "description": "Hot recency window for entity scoring",
      "x-visibility": "advanced"
    },
    "top_entities_per_project": {
      "type": "integer",
      "default": 5,
      "minimum": 1,
      "maximum": 20,
      "description": "Top entities shown per project",
      "x-visibility": "advanced"
    },
    "tokens_per_char": {
      "type": "number",
      "default": 0.25,
      "minimum": 0.1,
      "maximum": 1.0,
      "description": "Token-to-character ratio for budget calculation",
      "x-visibility": "expert"
    },
    "project_header_tokens": {
      "type": "integer",
      "default": 48,
      "minimum": 16,
      "maximum": 256,
      "description": "Token budget for project headers in DCB",
      "x-visibility": "expert"
    },
    "min_shared_entities": {
      "type": "integer",
      "default": 2,
      "minimum": 1,
      "maximum": 10,
      "description": "Minimum shared entities to link conversations",
      "x-visibility": "advanced"
    },
    "session_window_secs": {
      "type": "integer",
      "default": 28800,
      "description": "Session window for project inference (8h)",
      "x-visibility": "advanced"
    },
    "link_threshold": {
      "type": "number",
      "default": 0.35,
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "Link probability threshold",
      "x-visibility": "advanced"
    },
    "auto_project_threshold": {
      "type": "number",
      "default": 0.55,
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "Auto-project assignment threshold",
      "x-visibility": "advanced"
    },
    "dormant_after_days": {
      "type": "integer",
      "default": 30,
      "minimum": 7,
      "maximum": 365,
      "description": "Days before project is considered dormant",
      "x-visibility": "advanced"
    },
    "scenario": {
      "type": "object",
      "description": "Scenario classification parameters",
      "properties": {
        "sparse_max_touches": {
          "type": "integer",
          "default": 6,
          "description": "Sparse scenario maximum touches"
        },
        "warm_max_touches": {
          "type": "integer",
          "default": 30,
          "description": "Warm scenario maximum touches"
        },
        "hot_recency_secs": {
          "type": "integer",
          "default": 43200,
          "description": "Hot recency window for scenario (12h)"
        },
        "cold_resume_secs": {
          "type": "integer",
          "default": 259200,
          "description": "Cold resume window (72h)"
        },
        "confidence_floor": {
          "type": "number",
          "default": 0.40,
          "description": "Minimum confidence for scenario classification"
        },
        "weights": {
          "type": "object",
          "description": "Scenario classification weights",
          "properties": {
            "a": { "type": "number", "default": 0.30 },
            "b": { "type": "number", "default": 0.25 },
            "c": { "type": "number", "default": 0.20 },
            "d": { "type": "number", "default": 0.15 },
            "e": { "type": "number", "default": 0.10 }
          }
        }
      }
    }
  },
  "additionalProperties": false
}
