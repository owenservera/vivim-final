{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vivim.app/schemas/provider.schema.json",
  "title": "ProviderConfig",
  "type": "object",
  "properties": {
    "default_provider": {
      "type": "string",
      "default": "gemini",
      "enum": ["gemini", "openai", "claude", "deepseek", "grok", "perplexity"],
      "description": "Default AI provider",
      "x-visibility": "basic",
      "x-stability": "stable"
    },
    "response_timeout_secs": {
      "type": "integer",
      "default": 30,
      "minimum": 5,
      "maximum": 300,
      "description": "Timeout for provider API responses",
      "x-visibility": "basic",
      "x-stability": "stable"
    },
    "broadcast_channel_size": {
      "type": "integer",
      "default": 32,
      "minimum": 8,
      "maximum": 1024,
      "description": "Provider broadcast channel capacity",
      "x-visibility": "expert",
      "x-stability": "stable"
    },
    "max_pending_responses": {
      "type": "integer",
      "default": 100,
      "minimum": 10,
      "maximum": 1000,
      "description": "Maximum pending provider responses",
      "x-visibility": "expert",
      "x-stability": "stable"
    },
    "call_timeout_secs": {
      "type": "integer",
      "default": 35,
      "minimum": 5,
      "maximum": 300,
      "description": "Timeout for provider function calls",
      "x-visibility": "advanced",
      "x-stability": "stable"
    },
    "per_provider": {
      "type": "object",
      "description": "Per-provider configuration overrides",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "timeout_secs": { "type": "integer", "minimum": 5, "maximum": 300 },
          "max_retries": { "type": "integer", "minimum": 0, "maximum": 10 },
          "backoff_base_ms": { "type": "integer", "minimum": 100, "maximum": 10000 },
          "rate_limit_rps": { "type": "integer", "minimum": 1, "maximum": 100 }
        }
      }
    }
  },
  "additionalProperties": false
}
