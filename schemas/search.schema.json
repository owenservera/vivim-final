{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vivim.app/schemas/search.schema.json",
  "title": "SearchConfig",
  "type": "object",
  "properties": {
    "commit_doc_threshold": {
      "type": "integer",
      "default": 256,
      "minimum": 10,
      "maximum": 10000,
      "description": "Number of documents before Tantivy auto-commit",
      "x-visibility": "expert"
    },
    "commit_idle_ms": {
      "type": "integer",
      "default": 5000,
      "minimum": 500,
      "maximum": 60000,
      "description": "Idle time before Tantivy auto-commit",
      "x-visibility": "expert"
    },
    "cache_ttl_secs": {
      "type": "integer",
      "default": 90,
      "minimum": 10,
      "maximum": 600,
      "description": "Search result cache TTL in seconds",
      "x-visibility": "advanced"
    },
    "default_limit": {
      "type": "integer",
      "default": 10,
      "minimum": 1,
      "maximum": 100,
      "description": "Default search result limit",
      "x-visibility": "basic"
    },
    "max_results": {
      "type": "integer",
      "default": 100,
      "minimum": 10,
      "maximum": 10000,
      "description": "Maximum search results per query",
      "x-visibility": "advanced"
    },
    "tokenizer": {
      "type": "string",
      "default": "default",
      "enum": ["default", "raw", "stem", "ngram"],
      "description": "Tantivy tokenization strategy",
      "x-visibility": "advanced"
    }
  },
  "additionalProperties": false
}
