{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vivim.app/schemas/gemini.schema.json",
  "title": "GeminiConfig",
  "type": "object",
  "properties": {
    "origin": {
      "type": "string",
      "default": "https://gemini.google.com",
      "description": "Gemini web app origin",
      "x-visibility": "basic"
    },
    "batchexecute_url": {
      "type": "string",
      "description": "Gemini batchexecute RPC endpoint path",
      "x-visibility": "advanced"
    },
    "stream_generate_url": {
      "type": "string",
      "description": "Gemini StreamGenerate RPC endpoint path",
      "x-visibility": "advanced"
    },
    "default_hl": {
      "type": "string",
      "default": "en",
      "description": "Gemini language parameter",
      "x-visibility": "advanced"
    },
    "default_rt": {
      "type": "string",
      "default": "c",
      "description": "Gemini RT parameter",
      "x-visibility": "advanced"
    },
    "auth_origin": {
      "type": "string",
      "default": "https://gemini.google.com",
      "description": "Gemini authentication origin",
      "x-visibility": "advanced"
    },
    "profile_cache_ttl_ms": {
      "type": "integer",
      "default": 180000,
      "description": "Profile cache TTL in milliseconds (3 min)",
      "x-visibility": "advanced"
    },
    "rate_limit_window_ms": {
      "type": "integer",
      "default": 10000,
      "description": "Rate limiter window in milliseconds (10s)",
      "x-visibility": "advanced"
    },
    "sync_throttle_ms": {
      "type": "integer",
      "default": 10000,
      "description": "Sync throttle interval in milliseconds",
      "x-visibility": "advanced"
    },
    "model_unavailable_code": {
      "type": "integer",
      "default": 1003,
      "description": "Error code for model unavailable",
      "x-visibility": "expert"
    },
    "model_tier_code": {
      "type": "integer",
      "default": 1096,
      "description": "Error code for model tier restriction",
      "x-visibility": "expert"
    }
  },
  "additionalProperties": false
}
