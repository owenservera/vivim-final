{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vivim.app/schemas/logging.schema.json",
  "title": "LoggingConfig",
  "type": "object",
  "properties": {
    "level": {
      "type": "string",
      "default": "info",
      "enum": ["trace", "debug", "info", "warn", "error"],
      "description": "Tracing log level filter",
      "x-visibility": "basic",
      "x-stability": "stable"
    },
    "file_rotation_days": {
      "type": "integer",
      "default": 7,
      "minimum": 1,
      "maximum": 90,
      "description": "Log file rotation period in days",
      "x-visibility": "advanced",
      "x-stability": "stable"
    },
    "ws_broadcast_capacity": {
      "type": "integer",
      "default": 1000,
      "minimum": 100,
      "maximum": 10000,
      "description": "WebSocket log broadcast channel capacity",
      "x-visibility": "expert",
      "x-stability": "stable"
    },
    "format": {
      "type": "string",
      "default": "json",
      "enum": ["json", "text"],
      "description": "Log output format",
      "x-visibility": "advanced",
      "x-stability": "stable"
    },
    "console_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Enable console log output (debug builds only)",
      "x-visibility": "advanced",
      "x-stability": "stable"
    }
  },
  "additionalProperties": false
}
