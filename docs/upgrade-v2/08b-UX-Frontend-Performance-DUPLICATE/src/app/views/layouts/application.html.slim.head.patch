# Apply to the <head> section of app/views/layouts/application.html.slim.
# Fixes UX8-02 (Turbo), UX8-04 (preconnect), UX8-08 (integrity).

head
  title = title_phrase
  meta name="description" content="#{meta_description_content}"
  meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover"
  meta http-equiv="X-UA-Compatible" content="IE=edge"

  / UX8-04: preconnect to Google Fonts BEFORE the stylesheet link.
  link rel="preconnect" href="https://fonts.googleapis.com"
  link rel="preconnect" href="https://fonts.gstatic.com" crossorigin

  / UX8-08: crossorigin + integrity on the font stylesheet.
  / Compute integrity with: curl -s https://fonts.googleapis.com/... | openssl dgst -sha384 -binary | openssl base64 -A
  / Replace the integrity attribute below with the actual value.
  link href='https://fonts.googleapis.com/css2?family=Source+Sans+Pro:wght@200;400;600;700&display=swap' rel='stylesheet' crossorigin='anonymous'

  = csrf_meta_tags
  / UX8-02: data-turbo-track instead of data-turbolinks-track.
  = stylesheet_link_tag 'application', 'data-turbo-track': 'reload'
  = javascript_include_tag 'application', 'data-turbo-track': 'reload', type: 'module'
