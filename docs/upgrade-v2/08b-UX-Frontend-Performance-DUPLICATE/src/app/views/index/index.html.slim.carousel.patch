# Replace the .owl-carousel section (lines 59-78) with a CSS scroll-snap version.
# Also adds UX8-05 <picture> with WebP + AVIF + PNG fallback.

section.block id="projects"
  .container
    header
      h2 Recent Projects
      span.line
    .row data-carousel="true" data-autoplay="5000"
      - %w[iPhone-App-Design-in-denver mobile-denver-app-development iOS-app-development-in-denver android-app-design-denver android-app-development-company-denver iphone-app-development-company-denver mobile-application-development denver-website-design denver-web-design denver-mobile-application-development android-app-development-denver WebDesign].each do |img|
        a.colorbox href="images/#{img}.webp"
          picture
            source srcset="images/#{img}.avif" type="image/avif"
            source srcset="images/#{img}.webp" type="image/webp"
            img.img-fluid src="images/#{img}.png" alt="Denver mobile app development project: #{img.humanize}" loading="lazy" decoding="async" width="240" height="180"
