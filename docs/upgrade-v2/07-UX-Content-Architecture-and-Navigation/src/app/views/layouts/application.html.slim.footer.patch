# Replace the footer .social block (lines 91-96) and copyright (line 84):
# UX7-03: remove Google+ (shut down April 2019).
# UX7-04: add privacy + terms links.
# UX7-07: replace </br> with valid HTML.
# UX7-08: nav items use natural case + CSS text-transform.

# Footer social block - Google+ removed:
.social
  a.facebook href="https://www.facebook.com/Vivimdesign" aria-label="Vivim on Facebook"
    i.icon-facebook
  a.twitter href="https://twitter.com/VivimDesign" aria-label="Vivim on Twitter"
    i.icon-twitter
  a.linkedin href="https://www.linkedin.com/company/vivim" aria-label="Vivim on LinkedIn"
    i.icon-linkedin

# Footer address - valid HTML (UX7-07):
li: address
  a href='https://www.google.com/maps/place/8400+E+Crescent+Pkwy+%23600,+Englewood,+CO+80111'
    | 8400 East Crescent Parkway Suite 600
    br
    | Greenwood Village, CO 80111

# Footer legal links (UX7-04):
.row
  .col-lg-12
    p = "© #{Date.current.year} - #{t('vivim.site.copyright')}"
    p.legal-links
      = link_to 'Privacy Policy', privacy_path
      |  ·
      = link_to 'Terms of Service', terms_path

# Nav items in natural case (UX7-08) - pair with CSS:
#   .nav-link { text-transform: uppercase; letter-spacing: 0.05em; }
ul.nav.navbar-nav
  li: a.scroller href="#{root_path}#aboutus" data-section="#aboutus" About us
  li: a.scroller href="#{root_path}#experts" data-section="#experts" Experts
  li: a.scroller href="#{root_path}#projects" data-section="#projects" Projects
  li: a.scroller href="#{root_path}#clients" data-section="#clients" Clients
  li = link_to 'Why RoR?', why_ror_path
  li = link_to 'Mobile', mobile_path
  li: a.scroller href="#{root_path}#contact" data-section="#contact" Contact us
