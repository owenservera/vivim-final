# UX7-06: branded 404 page with site nav (rendered inside application layout).
section.block
  .container.text-center
    header
      h2 404 - Page Not Found
      span.line
    .row
      .col-sm-8.col-sm-offset-2
        p.lead We couldn't find the page you were looking for.
        p It may have moved or been renamed. Try one of these:
        ul.list-inline
          li = link_to 'Home', root_path
          li = link_to 'About us', about_us_path
          li = link_to 'Projects', projects_path
          li = link_to 'Contact', contact_us_path
        p Or #{link_to 'email us', 'mailto:info@vivim.net'} and we'll point you in the right direction.
