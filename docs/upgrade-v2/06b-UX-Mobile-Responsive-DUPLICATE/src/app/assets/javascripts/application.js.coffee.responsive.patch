# Replace the body of app/assets/javascripts/application.js.coffee with:
# Fixes: UX6-05 (prefers-reduced-motion), UX6-06 (colorbox replacement is out of
# scope here, but the carousel now respects reduced motion and has controls).

$ ->
  reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches

  # UX6-06: replace colorbox with GLightbox (load via npm/yarn, not jQuery plugin)
  if typeof GLightbox != 'undefined'
    lightbox = GLightbox(selector: 'a.colorbox', touchNavigation: true, loop: true)

  # UX6-05: carousel respects prefers-reduced-motion
  $('.owl-carousel').owlCarousel
    items: 4
    loop: true
    nav: true              # show prev/next arrows
    navText: ['<i class="fa fa-chevron-left"></i>', '<i class="fa fa-chevron-right"></i>']
    dots: true
    autoplay: !reducedMotion
    autoplayTimeout: 5000
    autoplayHoverPause: true
    responsive:
      0:    { items: 1 }
      480:  { items: 2 }
      768:  { items: 3 }
      992:  { items: 4 }
