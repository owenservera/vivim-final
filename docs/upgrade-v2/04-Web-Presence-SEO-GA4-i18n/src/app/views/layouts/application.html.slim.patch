# Apply these changes to app/views/layouts/application.html.slim:

head
  title = title_phrase
  meta name="description" content="#{meta_description_content}"
  / WEB-02: keywords meta tag removed (Google ignores it since 2009)
  meta name="viewport" content="width=device-width, initial-scale=1.0"
  meta http-equiv="X-UA-Compatible" content="IE=edge"

  / WEB-05: canonical + Open Graph + Twitter Card
  = canonical_link_tag
  meta property="og:title" content="#{title_phrase}"
  meta property="og:description" content="#{meta_description_content}"
  meta property="og:url" content=request.original_url
  meta property="og:image" content="https://vivim.net/banner.png"
  meta property="og:type" content="website"
  meta name="twitter:card" content="summary_large_image"
  meta name="twitter:title" content="#{title_phrase}"
  meta name="twitter:description" content="#{meta_description_content}"
  meta name="twitter:image" content="https://vivim.net/banner.png"

  / WEB-06: JSON-LD structured data
  script type="application/ld+json"
    == local_business_json_ld

  link rel="shortcut icon" href="/favicon.png"

  = csrf_meta_tags
  = stylesheet_link_tag 'application', 'data-turbolinks-track' => true
  = javascript_include_tag 'application', 'data-turbolinks-track' => true

  / WEB-07: HTTPS Google Fonts (was http://)
  link href='https://fonts.googleapis.com/css?family=Source+Sans+Pro:200,300,400,600,700,900,200italic,300italic,400italic,600italic,700italic,900italic' rel='stylesheet' type='text/css'
