# Apply these changes to config/environments/production.rb:

# 1. Tag every log line with request_id and remote_ip (REL-07):
config.log_tags = [:request_id, :remote_ip]

# 2. Configure ActionMailer to raise on delivery errors in staging
#    but swallow them in production (REL-01 - the controller handles rescue):
config.action_mailer.raise_delivery_errors = false
config.action_mailer.perform_deliveries = true
config.action_mailer.delivery_method = :smtp
config.action_mailer.smtp_settings = {
  address: ENV.fetch('SMTP_HOST', 'localhost'),
  port: ENV.fetch('SMTP_PORT', 587).to_i,
  domain: ENV.fetch('SMTP_DOMAIN', 'vivim.net'),
  user_name: ENV.fetch('SMTP_USERNAME'),
  password: ENV.fetch('SMTP_PASSWORD'),
  authentication: :plain,
  enable_starttls_auto: true,
}
