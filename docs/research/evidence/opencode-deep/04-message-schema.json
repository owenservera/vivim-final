{
  "type": "object",
  "properties": {
    "messageID": {
      "type": "string",
      "pattern": "^msg"
    },
    "model": {
      "type": "object",
      "properties": {
        "providerID": {
          "type": "string"
        },
        "modelID": {
          "type": "string"
        }
      },
      "required": [
        "providerID",
        "modelID"
      ],
      "additionalProperties": false
    },
    "agent": {
      "type": "string"
    },
    "noReply": {
      "type": "boolean"
    },
    "tools": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "format": {
      "$ref": "#/components/schemas/OutputFormat"
    },
    "system": {
      "type": "string"
    },
    "variant": {
      "type": "string"
    },
    "parts": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "$ref": "#/components/schemas/TextPartInput"
          },
          {
            "$ref": "#/components/schemas/FilePartInput"
          },
          {
            "$ref": "#/components/schemas/AgentPartInput"
          },
          {
            "$ref": "#/components/schemas/SubtaskPartInput"
          }
        ]
      }
    }
  },
  "required": [
    "parts"
  ],
  "additionalProperties": false
}
