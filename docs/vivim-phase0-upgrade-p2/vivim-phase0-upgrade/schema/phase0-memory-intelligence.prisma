/// Phase 0: Memory & Intelligence Schema Additions
/// Vivim Project — Persistent Memory, Entity Extraction, Decision Tracking,
/// Pattern Mining, Topic Management, and Import Infrastructure
///
/// Convention notes:
///   - All IDs are ULID strings (String @id)
///   - Timestamps are BigInt (epoch millis)
///   - Soft delete via isDeleted Int @default(0)
///   - Foreign keys use onDelete: Cascade where appropriate
///   - @@map("memory_entity") prefix pattern for table names

// ─────────────────────────────────────────────────────────────────────────────
// 1. Entity — Knowledge-graph nodes (people, technologies, projects, concepts, orgs)
// ─────────────────────────────────────────────────────────────────────────────

model Entity {
  id          String   @id
  name        String
  type        String   // person | technology | project | concept | organization
  description String?
  confidence  Float    @default(1.0)
  mentionCount Int     @default(0)
  isDeleted   Int      @default(0)
  createdAt   BigInt
  updatedAt   BigInt

  mentions    EntityMention[]
  embeddings  MemoryEmbedding[]

  @@unique([name, type])
  @@index([type])
  @@index([name])
  @@map("memory_entity")
}

// ─────────────────────────────────────────────────────────────────────────────
// 2. EntityMention — Tracks where an entity is referenced in conversations
// ─────────────────────────────────────────────────────────────────────────────

model EntityMention {
  id             String  @id
  entityId       String
  conversationId String
  messageId      String
  snippet        String?
  contextType    String  @default("reference")
  isDeleted      Int     @default(0)
  createdAt      BigInt

  entity         Entity  @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@index([entityId])
  @@index([conversationId])
  @@index([messageId])
  @@map("memory_entity_mention")
}

// ─────────────────────────────────────────────────────────────────────────────
// 3. DecisionRecord — Captures decisions made during conversations
// ─────────────────────────────────────────────────────────────────────────────

model DecisionRecord {
  id               String  @id
  conversationId   String
  decisionText     String
  rationale        String?
  alternativesJson String  @default("[]")
  isReversed       Int     @default(0)
  isDeleted        Int     @default(0)
  createdAt        BigInt
  updatedAt        BigInt

  @@index([conversationId])
  @@map("memory_decision_record")
}

// ─────────────────────────────────────────────────────────────────────────────
// 4. PatternExtract — Extracted recurring patterns across conversations
// ─────────────────────────────────────────────────────────────────────────────

model PatternExtract {
  id          String   @id
  name        String
  patternType String
  description String?
  occurrences Int      @default(1)
  confidence  Float    @default(0.5)
  isDeleted   Int      @default(0)
  createdAt   BigInt
  updatedAt   BigInt

  @@unique([name, patternType])
  @@index([patternType])
  @@map("memory_pattern_extract")
}

// ─────────────────────────────────────────────────────────────────────────────
// 5. Topic — Auto-generated or manually curated conversation topics
// ─────────────────────────────────────────────────────────────────────────────

model Topic {
  id              String   @id
  name            String
  description     String?
  color           String   @default("#6366f1")
  isAutoGenerated Int      @default(0)
  isDeleted       Int      @default(0)
  createdAt       BigInt
  updatedAt       BigInt

  conversationTopics ConversationTopic[]

  @@index([name])
  @@map("memory_topic")
}

// ─────────────────────────────────────────────────────────────────────────────
// 6. Project — Project-level grouping and tracking
// ─────────────────────────────────────────────────────────────────────────────

model Project {
  id          String   @id
  name        String
  description String?
  color       String   @default("#8b5cf6")
  isDeleted   Int      @default(0)
  createdAt   BigInt
  updatedAt   BigInt

  @@index([name])
  @@map("memory_project")
}

// ─────────────────────────────────────────────────────────────────────────────
// 7. ConversationTopic — Junction table linking conversations to topics
// ─────────────────────────────────────────────────────────────────────────────

model ConversationTopic {
  id             String  @id
  conversationId String
  topicId        String
  assignmentType String  @default("auto")
  isDeleted      Int     @default(0)
  createdAt      BigInt

  topic          Topic   @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([conversationId, topicId])
  @@index([topicId])
  @@map("memory_conversation_topic")
}

// ─────────────────────────────────────────────────────────────────────────────
// 8. UserPreference — Learned or explicit user preferences
// ─────────────────────────────────────────────────────────────────────────────

model UserPreference {
  id         String  @id
  userId     String  @default("default")
  key        String
  value      String
  source     String  @default("learned")
  confidence Float   @default(1.0)
  isDeleted  Int     @default(0)
  createdAt  BigInt
  updatedAt  BigInt

  @@unique([userId, key])
  @@index([userId])
  @@map("memory_user_preference")
}

// ─────────────────────────────────────────────────────────────────────────────
// 9. ImportJob — Tracks bulk import operations with progress and error info
// ─────────────────────────────────────────────────────────────────────────────

model ImportJob {
  id                 String  @id
  source             String
  filePath           String?
  status             String  @default("pending")
  totalConversations Int     @default(0)
  importedCount      Int     @default(0)
  duplicatesSkipped  Int     @default(0)
  errorsCount        Int     @default(0)
  resultJson         String  @default("{}")
  isDeleted          Int     @default(0)
  createdAt          BigInt
  updatedAt          BigInt

  @@index([status])
  @@map("memory_import_job")
}

// ─────────────────────────────────────────────────────────────────────────────
// 10. MemoryEmbedding — Vector embeddings for semantic search over entities
// ─────────────────────────────────────────────────────────────────────────────

model MemoryEmbedding {
  id          String  @id
  entityType  String
  entityId    String
  vector      String
  model       String  @default("text-embedding-3-small")
  dimensions  Int     @default(1536)
  isDeleted   Int     @default(0)
  createdAt   BigInt

  entity      Entity  @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@unique([entityType, entityId, model])
  @@index([entityType])
  @@index([entityId])
  @@map("memory_embedding")
}
