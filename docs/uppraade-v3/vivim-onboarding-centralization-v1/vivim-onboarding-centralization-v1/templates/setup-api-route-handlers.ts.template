import { NextRequest, NextResponse } from 'next/server';
// Adjust this import to match the actual export shape of setup-router.ts:
import {
  handleListProfiles,
  handleLaunchVisible,
  handleVerify,
  handleComplete,
  handleKill,
  handleGetWorkspace,
  handleSetWorkspace,
} from '@/../../src/server/setup-router';

// ---------------------------------------------------------------------------
// GET /api/setup/profiles
// ---------------------------------------------------------------------------

// frontend/src/app/api/setup/profiles/route.ts
export async function GET() {
  try {
    const result = await handleListProfiles();
    return NextResponse.json(result);
  } catch (err) {
    const message = err instanceof Error ? err.message : 'Unknown error';
    return NextResponse.json({ ok: false, error: message }, { status: 500 });
  }
}

