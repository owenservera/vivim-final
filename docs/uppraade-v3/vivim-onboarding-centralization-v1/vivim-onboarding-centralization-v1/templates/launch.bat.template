@echo off
REM scripts/tauri/launch.bat
REM
REM Desktop launcher for the Vivim NSIS install path.
REM
REM Changes from the original:
REM   1. Sets FRONTEND_DIR so the backend serves static frontend files
REM      (Task 04 — without this, http://localhost:9420 returns 404).
REM   2. Runs vivim-server.exe in the FOREGROUND (not start /B) so closing
REM      this window kills the sidecar (Task 10 — clean shutdown).
REM   3. Opens the browser after a 3-second delay via a background helper.
REM
REM Install layout (written by installer.nsi):
REM   %LOCALAPPDATA%\Vivim\
REM     vivim-server.exe
REM     launch.bat
REM     frontend\
REM       index.html
REM       _next\static\...
REM     data\
REM       seed-snapshot.db     (embedded by compile-sidecar.ts, Task 05)
REM     config\
REM       providers.json

set "INSTDIR=%~dp0"
set "BACKEND_EXE=%INSTDIR%vivim-server.exe"
set "PORT=9420"
set NODE_ENV=production
set "FRONTEND_DIR=%INSTDIR%frontend"

echo ===============================================
echo   Vivim Desktop
echo ===============================================
echo   Install dir: %INSTDIR%
echo   Backend:     %BACKEND_EXE%
echo   Port:        %PORT%
echo   Frontend:    %FRONTEND_DIR%
echo ===============================================
echo.

REM Open the browser after a 3-second delay (non-blocking).
REM The sidecar needs a moment to bind to the port before the browser hits it.
start /B cmd /c "timeout /t 3 /nobreak >nul && start """" http://localhost:%PORT%"

REM Run the sidecar in the foreground.
REM Closing this window sends SIGINT to vivim-server.exe, killing it cleanly.
"%BACKEND_EXE%" serve --port %PORT%

REM If we reach here, the sidecar exited.
echo.
echo Vivim Backend has exited. Press any key to close this window.
pause >nul
