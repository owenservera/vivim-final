// Append to prisma/schema.prisma
//
// UserOnboarding — persists per-user onboarding tour state.
// Replaces the in-memory MemoryOnboardingStore for production use.
//
// Notes:
// - completedSteps and tourTimings are JSON-encoded strings because SQLite
//   doesn't support arrays or JSON columns natively through Prisma.
// - Timestamps are BigInt (ms since epoch) to survive past 2038.
// - lastShownAt is kept for backward compat with the legacy MemoryOnboardingStore
//   which (buggily) set it on step completion. New code should prefer lastCompletedAt.

model UserOnboarding {
  id              String  @id @default(cuid())
  userId          String  @unique
  completedSteps  String  @default("[]")    // JSON array of step IDs
  dismissed       Boolean @default(false)
  lastShownAt     BigInt?                   // ms since epoch (legacy)
  lastCompletedAt BigInt?                   // ms since epoch (preferred)
  tourTimings     String?                   // JSON: { stepId: durationMs }
  createdAt       BigInt  @default(unixepoch() * 1000)
  updatedAt       BigInt  @default(unixepoch() * 1000)

  @@index([userId])
}
