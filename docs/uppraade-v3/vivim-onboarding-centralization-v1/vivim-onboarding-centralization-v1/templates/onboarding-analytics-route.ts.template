// templates/onboarding-analytics-route.ts.template
//
// frontend/src/app/api/onboarding/analytics/route.ts
//
// Accepts fire-and-forget analytics events from the OnboardingTour and
// the help system. Persists to an in-memory ring buffer (last 10,000 events)
// and logs at info level.
//
// Persistence note: in-memory is fine for v1. The analytics are for product
// insight, not billing. Future pack can add a TourAnalyticsEvent Prisma model.

import { NextRequest, NextResponse } from 'next/server';
import type { TourAnalyticsEvent } from '@/shared/onboarding';

const BUFFER_MAX = 10_000;
const buffer: TourAnalyticsEvent[] = [];

function pushEvent(event: TourAnalyticsEvent): void {
  buffer.push(event);
  if (buffer.length > BUFFER_MAX) {
    buffer.shift();
  }
  // Structured log — pino picks this up
  console.log(JSON.stringify({
    level: 'info',
    msg: 'onboarding-analytics',
    event,
  }));
}

export async function POST(req: NextRequest) {
  try {
    const body = await req.json();

    // Basic validation — accept any object with a known `type` and a `userId`.
    if (!body || typeof body.type !== 'string' || typeof body.userId !== 'string') {
      return NextResponse.json(
        { ok: false, error: 'Invalid event: missing type or userId' },
        { status: 400 }
      );
    }

    const validTypes = new Set([
      'tour_started',
      'step_viewed',
      'step_completed',
      'step_action_clicked',
      'tour_completed',
      'tour_dismissed',
    ]);

    if (!validTypes.has(body.type)) {
      return NextResponse.json(
        { ok: false, error: `Invalid event type: ${body.type}` },
        { status: 400 }
      );
    }

    // Coerce to the union type — we've validated the discriminator.
    const event = body as TourAnalyticsEvent;
    pushEvent(event);

    return NextResponse.json({ ok: true });
  } catch (err) {
    const message = err instanceof Error ? err.message : 'Unknown error';
    return NextResponse.json({ ok: false, error: message }, { status: 500 });
  }
}

// Optional: GET endpoint to query recent events (for debugging / dashboards).
// Not required by the frontend; useful for ops.
export async function GET(req: NextRequest) {
  const url = new URL(req.url);
  const limit = Number(url.searchParams.get('limit') ?? 100);
  const userId = url.searchParams.get('userId');

  let events = buffer.slice(-Math.min(limit, BUFFER_MAX));
  if (userId) {
    events = events.filter((e) => e.userId === userId);
  }

  return NextResponse.json({ ok: true, events, total: buffer.length });
}
