# .env.example — vivim-final
#
# Copy to .env and edit. All vars have sensible defaults for development.
# See README.md for install instructions and docs/CONFIGURATION.md for details.

# === Server ===
CAP_STORE_HOST=127.0.0.1
CAP_STORE_PORT=9420
# Bearer token for API auth (optional — leave empty for no auth in dev)
CAP_STORE_AUTH_TOKEN=
# Comma-separated list of allowed CORS origins
CAP_STORE_CORS_ORIGIN=http://localhost:3000,http://localhost:5175

# === Storage ===
# Root data directory (defaults to ~/.local/share/vivim/cap-store on Linux,
# %LOCALAPPDATA%\vivim\cap-store on Windows)
CAP_STORE_DATA_DIR=
# SQLite database path (defaults to <dataDir>/cap-store.sqlite)
CAP_STORE_DB_PATH=
# If set, overrides CAP_STORE_DB_PATH for Prisma datasource
DATABASE_URL=
# Enable DB encryption (experimental)
CAP_STORE_ENCRYPT_DB=false

# === Chrome / Fleet ===
# Chrome binary path (auto-detected if empty)
CAP_STORE_CHROME_PATH=
# Chrome slave profile root (defaults to <dataDir>/chrome-profiles)
CAP_STORE_PROFILE_DIR=
# Auto-launch the Chrome slave fleet on boot (default: false)
CAP_STORE_AUTO_START_FLEET=false
# CDP port range for Chrome slaves
CAP_STORE_FLEET_PORT_START=9222
CAP_STORE_FLEET_PORT_END=9250
# Health probe interval for Chrome slaves (ms)
CAP_STORE_HEALTH_PROBE_MS=30000

# === Circuit Breaker ===
CAP_STORE_CIRCUIT_THRESHOLD=5
CAP_STORE_CIRCUIT_RESET_MS=30000
CAP_STORE_HPE_RETENTION_DAYS=30

# === Frontend ===
# If set, the backend serves static frontend files from this directory
# (production / desktop packaging only — leave empty for dev)
FRONTEND_DIR=
# Public API URL the frontend uses for browser-side fetches
NEXT_PUBLIC_API_URL=http://localhost:9420

# === Logging ===
# pino log level: trace | debug | info | warn | error | fatal
CAP_STORE_LOG_LEVEL=info

# === Provider API Keys (optional) ===
# Only needed if using API providers (not Chrome-login providers like ChatGPT/Claude/Gemini)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
GOOGLE_API_KEY=

# === OpenTelemetry (optional) ===
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=vivim-final

# === OpenCode Server (optional) ===
OPENCODE_SERVE_ENABLED=0
OPENCODE_SERVE_PORT=0
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=

# === MCP Server (optional) ===
MCP_PORT=0

# === Dev-only flags ===
# When true, runs ensure-accounts.ts on boot (currently no-op — KNOWN_ACCOUNTS is empty)
CAP_STORE_ENSURE_ACCOUNTS=false
# When set (to any value), forces re-seed even if DB already has providers
FORCE_SEED=
# Debug mode (verbose logs)
DEBUG=false
