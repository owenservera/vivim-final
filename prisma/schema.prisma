// ───────────────────────────────────────────────────────────────────────────
// L-NLCL: Natural Language Command Layer — Knowledge Graph
// A network graph of command knowledge (intents, aliases, keywords, examples,
// synonyms, normalization rules). Expansion = add nodes/edges, no code edits.
// ───────────────────────────────────────────────────────────────────────────

model NlclGraphNode {
  id        String  @id
  kind      String
  label     String
  dataJson  String? @map("data_json")
  createdAt BigInt     @default(0) @map("created_at")

  @@index([kind], map: "idx_nlcl_nodes_kind")
  @@index([label], map: "idx_nlcl_nodes_label")
  @@map("nlcl_graph_nodes")
}

model NlclGraphEdge {
  id        String  @id
  fromId    String  @map("from_id")
  toId      String  @map("to_id")
  relation  String
  weight    Float   @default(1)
  dataJson  String? @map("data_json")
  createdAt BigInt     @default(0) @map("created_at")

  @@index([fromId], map: "idx_nlcl_edges_from")
  @@index([toId], map: "idx_nlcl_edges_to")
  @@index([relation], map: "idx_nlcl_edges_rel")
  @@map("nlcl_graph_edges")
}

