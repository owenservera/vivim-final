// ═══════════════════════════════════════════════════════════════════
// Migration 002: Chat Upgrade — Rich Content, Memory, Context
// ═══════════════════════════════════════════════════════════════════

// ── Group 1: Rich Message Content ────────────────────────────────────────

model ContentUnit {
  id              String  @id
  messageId       String  @map("message_id")
  conversationId  String  @map("conversation_id")
  unitType        String  @map("unit_type")
  content         String
  mimeType        String? @map("mime_type")
  metadataJson    String  @default("{}") @map("metadata_json")
  sequenceIndex   Int     @default(0) @map("sequence_index")
  qualityScore    Float?  @map("quality_score")
  createdAt       BigInt  @map("created_at")

  message ConversationMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId], map: "idx_cu_message")
  @@index([conversationId, unitType], map: "idx_cu_conv_type")
  @@map("content_unit")
}

model MessageLink {
  id              String  @id
  sourceMessageId String  @map("source_message_id")
  targetMessageId String  @map("target_message_id")
  relation        String
  weight          Float   @default(1.0)
  metadataJson    String  @default("{}") @map("metadata_json")
  createdAt       BigInt  @map("created_at")

  source ConversationMessage @relation("LinkSource", fields: [sourceMessageId], references: [id], onDelete: Cascade)
  target ConversationMessage @relation("LinkTarget", fields: [targetMessageId], references: [id], onDelete: Cascade)

  @@unique([sourceMessageId, targetMessageId, relation])
  @@index([sourceMessageId], map: "idx_ml_source")
  @@index([targetMessageId], map: "idx_ml_target")
  @@map("message_link")
}

model MessageEntity {
  id              String  @id
  messageId       String  @map("message_id")
  entityId        String  @map("entity_id")
  confidence      Float   @default(0.5)
  context         String
  extractionSource String @default("llm") @map("extraction_source")
  createdAt       BigInt  @map("created_at")

  message ConversationMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  entity  Entity             @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@unique([messageId, entityId])
  @@index([messageId], map: "idx_ment_message")
  @@index([entityId], map: "idx_ment_entity")
  @@map("message_entity")
}

// ── Group 2: Memory & Learning ───────────────────────────────────────────

model MemoryLink {
  id               String  @id
  sourceMemoryType String  @map("source_memory_type")
  sourceMemoryId   String  @map("source_memory_id")
  targetMemoryType String  @map("target_memory_type")
  targetMemoryId   String  @map("target_memory_id")
  relation         String
  strength         Float   @default(0.5)
  metadataJson     String  @default("{}") @map("metadata_json")
  createdAt        BigInt  @map("created_at")

  @@unique([sourceMemoryType, sourceMemoryId, targetMemoryType, targetMemoryId, relation])
  @@index([sourceMemoryType, sourceMemoryId], map: "idx_mlink_source")
  @@index([targetMemoryType, targetMemoryId], map: "idx_mlink_target")
  @@map("memory_link")
}

model MemoryAccess {
  id             String  @id
  memoryType     String  @map("memory_type")
  memoryId       String  @map("memory_id")
  accessReason   String  @map("access_reason")
  queryText      String? @map("query_text")
  resultRank     Int?    @map("result_rank")
  wasUsed        Int     @default(0) @map("was_used")
  latencyMs      Int     @map("latency_ms")
  createdAt      BigInt  @map("created_at")

  @@index([memoryType, memoryId], map: "idx_macc_memory")
  @@index([createdAt], map: "idx_macc_time")
  @@map("memory_access")
}

model ReflectionLog {
  id             String  @id
  providerId     String? @map("provider_id")
  conversationId String? @map("conversation_id")
  reflectionType String  @map("reflection_type")
  inputJson      String  @map("input_json")
  outputJson     String  @map("output_json")
  confidence     Float   @default(0.5)
  applied        Int     @default(0) @map("applied")
  createdAt      BigInt  @map("created_at")

  @@index([reflectionType], map: "idx_rl_type")
  @@index([conversationId], map: "idx_rl_conv")
  @@index([createdAt], map: "idx_rl_time")
  @@map("reflection_log")
}

// ── Group 3: Context Assembly ────────────────────────────────────────────

model ContextBudgetConfig {
  id                   String @id
  userId               String @default("default") @map("user_id")
  maxContextTokens     Int    @default(128000) @map("max_context_tokens")
  responseStyle        String @default("balanced") @map("response_style")
  compressionStrategy  String @default("auto") @map("compression_strategy")
  systemLayerPct       Float  @default(0.10) @map("system_layer_pct")
  memoryLayerPct       Float  @default(0.15) @map("memory_layer_pct")
  conversationLayerPct Float  @default(0.50) @map("conversation_layer_pct")
  situationLayerPct    Float  @default(0.10) @map("situation_layer_pct")
  reservePct           Float  @default(0.15) @map("reserve_pct")
  enablePredictions    Int    @default(1) @map("enable_predictions")
  enableJitRetrieval   Int    @default(1) @map("enable_jit_retrieval")
  enableCompression    Int    @default(1) @map("enable_compression")
  enableEntityContext  Int    @default(1) @map("enable_entity_context")
  enableTopicContext   Int    @default(1) @map("enable_topic_context")
  createdAt            BigInt @map("created_at")
  updatedAt            BigInt @map("updated_at")

  @@unique([userId])
  @@map("context_budget_config")
}

model SituationDetection {
  id               String  @id
  conversationId   String? @map("conversation_id")
  detectedType     String  @map("detected_type")
  confidence       Float
  signalsJson      String  @map("signals_json")
  recommendedAction String? @map("recommended_action")
  actionTaken      String? @map("action_taken")
  actionResult     String? @map("action_result")
  timestamp        Int

  @@index([conversationId], map: "idx_sd_conv")
  @@index([detectedType], map: "idx_sd_type")
  @@index([timestamp], map: "idx_sd_time")
  @@map("situation_detection")
}
