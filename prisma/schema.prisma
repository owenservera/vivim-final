model TransferAttempt {
  id                String  @id
  transferCandidateId String @map("transfer_candidate_id")
  ok                Int     @default(0)
  resultJson        String? @map("result_json")
  error             String?
  durationMs        Int?    @map("duration_ms")
  ts                Int

  candidate TransferCandidate @relation(fields: [transferCandidateId], references: [id], onDelete: Cascade)

  @@map("transfer_attempt")
}

model LearningEvent {
  id           String @id
  providerId   String @map("provider_id")
  capabilityId String @map("capability_id")
  eventType    String @map("event_type")
  dataJson     String @default("{}") @map("data_json")
  ts           Int

  provider   ProviderDefinition @relation(fields: [providerId], references: [id], onDelete: Cascade)
  capability CapabilityTaxonomy @relation(fields: [capabilityId], references: [id], onDelete: Cascade)

  @@map("learning_event")
}

model Rule {
  id            String  @id
  name          String
  ruleType      String  @map("rule_type")
  conditionJson String  @default("{}") @map("condition_json")
  actionJson    String  @default("{}") @map("action_json")
  isActive      Int     @default(1) @map("is_active")
  confidence    Float   @default(0.0)
  createdAt     Int     @map("created_at")
  updatedAt     Int     @map("updated_at")

  @@map("rule")
}

model BindingEvent {
  id        String @id
  bindingId String @map("binding_id")
  eventType String @map("event_type")
  dataJson  String @default("{}") @map("data_json")
  ts        Int

  binding CapabilityBinding @relation(fields: [bindingId], references: [id], onDelete: Cascade)

  @@map("binding_event")
}

model FailureClassification {
  id             String  @id
  outcomeId      String  @map("outcome_id")
  failureType    String  @map("failure_type")
  isRecoverable  Int     @default(0) @map("is_recoverable")
  suggestedAction String? @map("suggested_action")
  ts             Int

  outcome Outcome @relation(fields: [outcomeId], references: [id], onDelete: Cascade)

  @@map("failure_classification")
}

// ═══════════════════════════════════════════════════════════════════
// L13: Testing
// ═══════════════════════════════════════════════════════════════════

model TestRun {
  id           String  @id
  capabilityId String? @map("capability_id")
  bindingId    String? @map("binding_id")
  providerId   String? @map("provider_id")
  testType     String  @map("test_type")
  status       String  @default("running")
  resultJson   String? @map("result_json")
  startedAt    Int     @map("started_at")
  completedAt  Int?    @map("completed_at")

  @@map("test_run")
}

// ═══════════════════════════════════════════════════════════════════
// L14: SOTA — Shape-Agnostic Registration (Phase 8)
// ═══════════════════════════════════════════════════════════════════

model CapabilityShape {
  id                      String @id
  name                    String
  expectedCapsJson        String @map("expected_caps_json")
  discoveryHintsJson      String @map("discovery_hints_json")
  projectionRulesJson     String @map("projection_rules_json")
  parserExpectationsJson  String @map("parser_expectations_json")
  isBuiltIn               Int    @default(0) @map("is_built_in")
  createdAt               Int    @map("created_at")
  updatedAt               Int    @map("updated_at")

  @@map("capability_shape")
}

model CapabilityShapeBinding {
  id            String @id
  shapeId       String @map("shape_id")
  providerId    String @map("provider_id")
  capabilityId  String @map("capability_id")
  mappingJson   String @map("mapping_json")
  isActive      Int    @default(1) @map("is_active")
  createdAt     Int    @map("created_at")

  @@map("capability_shape_binding")
}

model ProviderArchetype {
  id            String @id
  shapeId       String @map("shape_id")
  name          String
  description   String?
  manifestJson  String @map("manifest_json")
  isDefault     Int    @default(0) @map("is_default")
  createdAt     Int    @map("created_at")
  updatedAt     Int    @map("updated_at")

  @@map("provider_archetype")
}

model ProviderShapeBinding {
  id            String @id
  providerId    String @map("provider_id")
  archetypeId   String @map("archetype_id")
  shapeId       String @map("shape_id")
  configJson    String? @map("config_json")
  isActive      Int    @default(1) @map("is_active")
  createdAt     Int    @map("created_at")

  @@map("provider_shape_binding")
}

model DiscoverySession {
  id                String  @id
  url               String
  status            String  @default("started")
  shapeId           String? @map("shape_id")
  confidence        Float   @default(0)
  capabilitiesJson  String  @map("capabilities_json")
  interactiveJson   String  @map("interactive_json")
  parserFormat      String? @map("parser_format")
  manifestDraftJson String? @map("manifest_draft_json")
  error             String?
  createdAt         Int     @map("created_at")
  updatedAt         Int     @map("updated_at")

  @@map("discovery_session")
}

model DiscoveryResult {
  id              String  @id
  sessionId       String  @map("session_id")
  providerId      String? @map("provider_id")
  approvedBy      String? @map("approved_by")
  manifestJson    String? @map("manifest_json")
  status          String  @default("pending")
  createdAt       Int     @map("created_at")

  @@map("discovery_result")
}

model MirrorState {
  id              String  @id
  conversationId  String  @unique @map("conversation_id")
  chromeStateJson String? @map("chrome_state_json")
  uiStateJson     String? @map("ui_state_json")
  pendingOpsJson  String? @map("pending_ops_json")
  lastSyncAt      Int     @map("last_sync_at")
  createdAt       Int     @map("created_at")
  updatedAt       Int     @map("updated_at")

  @@map("mirror_state")
}

model OptimisticUpdate {
  id                 String  @id
  conversationId     String  @map("conversation_id")
  action             String
  expectedStateJson  String  @map("expected_state_json")
  actualStateJson    String? @map("actual_state_json")
  confirmed          Int     @default(0)
  createdAt          Int     @map("created_at")
  resolvedAt         Int?    @map("resolved_at")

  @@map("optimistic_update")
}

model LatencyMeasurement {
  id              String @id
  conversationId  String @map("conversation_id")
  stage           String
  durationMs      Int    @map("duration_ms")
  timestamp       Int

  @@map("latency_measurement")
}

model MirrorSnapshot {
  id              String @id
  conversationId  String @map("conversation_id")
  trigger         String
  stateJson       String @map("state_json")
  timestamp       Int

  @@map("mirror_snapshot")
}

model ObservationEvent {
  id              String @id
  conversationId  String @map("conversation_id")
  slaveId         String @map("slave_id")
  eventType       String @map("event_type")
  dataJson        String @map("data_json")
  timestamp       Int

  @@map("observation_event")
}

// ── Phase 9: SOTA Workflow ─────────────────────────────────────────────

model WorkflowDefinition {
  id              String @id
  name            String
  description     String?
  nodesJson       String @map("nodes_json")
  edgesJson       String @map("edges_json")
  variablesJson   String? @map("variables_json")
  createdAt       Int    @map("created_at")
  updatedAt       Int    @map("updated_at")

  @@map("workflow_definition")
}

model WorkflowNode {
  id              String @id
  workflowId      String @map("workflow_id")
  nodeId          String @map("node_id")
  type            String
  category        String
  configJson      String @map("config_json")
  positionX       Int?   @map("position_x")
  positionY       Int?   @map("position_y")

  @@map("workflow_node")
}

model WorkflowEdge {
  id              String @id
  workflowId      String @map("workflow_id")
  edgeId          String @map("edge_id")
  source          String
  target          String
  condition       String?

  @@map("workflow_edge")
}

model WorkflowExecution {
  id              String @id
  workflowId      String @map("workflow_id")
  status          String
  inputJson       String? @map("input_json")
  outputJson      String? @map("output_json")
  startedAt       Int    @map("started_at")
  completedAt     Int?   @map("completed_at")

  @@map("workflow_execution")
}

model WorkflowNodeExecution {
  id                  String @id
  executionId         String @map("execution_id")
  nodeId              String @map("node_id")
  status              String
  inputJson           String? @map("input_json")
  outputJson          String? @map("output_json")
  error               String?
  startedAt           Int?   @map("started_at")
  completedAt         Int?   @map("completed_at")

  @@map("workflow_node_execution")
}

model WorkflowWebhook {
  id              String @id
  workflowId      String @map("workflow_id")
  path            String
  method          String
  active          Boolean @default(true)
  secret          String?
  createdAt       Int    @map("created_at")

  @@map("workflow_webhook")
}

model WorkflowCredential {
  id              String @id
  workflowId      String @map("workflow_id")
  name            String
  type            String
  valueEncrypted  String @map("value_encrypted")
  createdAt       Int    @map("created_at")

  @@map("workflow_credential")
}
