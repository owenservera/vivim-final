{
  "name": "vivim-web",
  "private": true,
  "type": "module",
  "workspaces": [
    "sandbox",
    "ui",
    "api-client"
  ],
  "scripts": {
    "dev": "bun run --cwd sandbox dev",
    "dev:sandbox": "bun run --cwd sandbox dev",
    "build": "bun run --cwd sandbox build",
    "typecheck": "bun run --cwd sandbox typecheck && bun run --cwd ui typecheck && bun run --cwd api-client typecheck",
    "lint": "biome check web/"
  }
}