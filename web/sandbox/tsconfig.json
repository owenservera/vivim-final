{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["DOM", "ESNext"],
    "strict": true,
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@ui": ["../ui/src/index.ts"],
      "@ui/*": ["../ui/src/*"],
      "@api-client": ["../api-client/src/index.ts"],
      "@api-client/*": ["../api-client/src/*"]
    }
  },
  "include": ["src/**/*", "src/**/*.ts", "src/**/*.tsx"]
}