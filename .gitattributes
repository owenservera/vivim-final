# Normalize line endings on checkout/commit to avoid the
# "LF will be replaced by CRLF" noise on Windows. Editors that need CRLF
# locally can override; the repository stores LF.
* text=auto eol=lf

# Keep Windows batch files with CRLF if any are added.
*.{cmd,[cC][mM][dD]} text eol=crlf
*.bat text eol=crlf
